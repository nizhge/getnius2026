# Server-only Gemini key. Do not prefix with NEXT_PUBLIC_ or commit a real key.
GEMINI_API_KEY=

# Agent graph cost controls for unknown/custom models.
AGENT_FALLBACK_INPUT_USD_PER_MTOK=1
AGENT_FALLBACK_OUTPUT_USD_PER_MTOK=5

# Set true only when this project intentionally uses Gemini Free Tier.
# This changes cost reporting to $0 but does not bypass model quotas/rate limits.
AGENT_ASSUME_FREE_TIER=false
